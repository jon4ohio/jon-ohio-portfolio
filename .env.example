# Production site origin — canonical URLs, robots.txt, and sitemap.xml (Vercel Production).
# Optional when using Vercel: VERCEL_PROJECT_PRODUCTION_URL is used automatically on production deploys.
NEXT_PUBLIC_SITE_URL=https://johnohio.vercel.app

# Search engine ownership verification (optional — set after creating GSC / Bing properties).
# Google: Search Console → Settings → Ownership verification → HTML tag → content value only.
GOOGLE_SITE_VERIFICATION=
# Bing: Webmaster Tools → verify via meta tag → content value only.
BING_SITE_VERIFICATION=
# IndexNow key for Bing/Yandex URL submission (optional). Hosts /{key}.txt at build time when set.
# Default key file is committed at public/jopindexnow.txt — set this to jopindexnow to enable submit:indexnow.
INDEXNOW_KEY=jopindexnow

# Figma REST API — used by npm run export:figma-assets
# Create a Personal Access Token: Figma → Settings → Security
FIGMA_TOKEN=

# Optional: only needed if you use a private npm registry locally.
NPM_TOKEN=
